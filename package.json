{
  "name": "healthcare-digital-twin",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital ward 3D digital twin: live medical device telemetry, clinical alerts and FHIR R4-shaped data, built with React Three Fiber",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
